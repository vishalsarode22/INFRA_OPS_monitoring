# InfraBeatOps system registry.
# Only ${VAR} references -- no secrets here. Safe to open in a screen share.

systems:
  - name: TST
    sap_system_id: TST
    client: "000"
    language: EN

    has_gui_access: true
    connection_name: ${TST_SAP_CONNECTION_NAME}
    username: ${TST_SAP_USERNAME}
    password: ${TST_SAP_PASSWORD}

    has_os_access: true
    ssh_host: ${TST_SSH_HOST}
    ssh_port: ${TST_SSH_PORT}
    ssh_username: ${TST_SSH_USERNAME}
    ssh_password: ${TST_SSH_PASSWORD}
    sap_instance_nr: "02"

    rfc:
      ashost: ${TST_RFC_HOST}
      sysnr: ${TST_RFC_SYSNR}
      client: ${TST_RFC_CLIENT}
      username: ${TST_RFC_USER}
      password: ${TST_RFC_PASSWORD}
      language: EN

  - name: FUJI_QAS
    sap_system_id: CEQ
    client: "000"
    language: EN

    has_gui_access: true
    connection_name: ${FUJI_QAS_SAP_CONNECTION_NAME}
    username: ${FUJI_QAS_SAP_USERNAME}
    password: ${FUJI_QAS_SAP_PASSWORD}

    has_os_access: false    # no OS access on this system

    rfc:
      ashost: ${FUJI_QAS_RFC_HOST}
      sysnr: ${FUJI_QAS_RFC_SYSNR}
      client: ${FUJI_QAS_RFC_CLIENT}
      username: ${FUJI_QAS_RFC_USER}
      password: ${FUJI_QAS_RFC_PASSWORD}
      language: EN
      saprouter: ${FUJI_QAS_SAPROUTER}

  - name: CENTOR_QAS
    sap_system_id: QAS
    client: "100"
    language: EN

    has_gui_access: true
    connection_name: ${QAS_SAP_CONNECTION_NAME}
    username: ${QAS_SAP_USERNAME}
    password: ${QAS_SAP_PASSWORD}

    has_os_access: false    # no OS access on this system

    rfc:
      ashost: ${QAS_RFC_HOST}
      sysnr: ${QAS_RFC_SYSNR}
      client: ${QAS_RFC_CLIENT}
      username: ${QAS_RFC_USER}
      password: ${QAS_RFC_PASSWORD}
      language: EN

  - name: FUJI_PRD
    sap_system_id: PRD
    client: "100"
    language: EN

    has_gui_access: false   # no SAP Logon entry on this workstation

    has_os_access: false    # no OS access on this system

    rfc:
      ashost: ${FUJI_PRD_RFC_HOST}
      sysnr: ${FUJI_PRD_RFC_SYSNR}
      client: ${FUJI_PRD_RFC_CLIENT}
      username: ${FUJI_PRD_RFC_USER}
      password: ${FUJI_PRD_RFC_PASSWORD}
      language: EN
      saprouter: ${FUJI_PRD_SAPROUTER}
