[Unit]
Description=InfraBeatOps collector (RFC sweeps, IBO_ROLE=collector; no SAP GUI on Linux)
After=network-online.target ibops-web.service
Wants=network-online.target

[Service]
Type=simple
User=ibops
WorkingDirectory=/home/ibops/app
Environment=IBO_ROLE=collector
ExecStart=/home/ibops/app/.venv/bin/python -m services.collector
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
