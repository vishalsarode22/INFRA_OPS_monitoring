[Unit]
Description=InfraBeatOps SAP Basis Monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/infrabeatops
EnvironmentFile=-/opt/infrabeatops/.env
ExecStart=/opt/infrabeatops/venv/bin/uvicorn dashboard.app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
User=infrabeatops
Group=infrabeatops

[Install]
WantedBy=multi-user.target
