# NEVER commit .env or real credentials to source control.
SAP_CLIENT=
SAP_USERNAME=
SAP_LANGUAGE=EN
SAP_PASSWORD=

SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PASSWORD=

SAP_INSTANCE_NR=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=


USE_MOCK_AI=

# InfraBeatOps AI/RCA
AI_PROVIDER=mock
GEMINI_MODEL=gemini-flash-latest
# GEMINI_API_KEY=replace-me

# --- Memory-dump owner routing (SAP_MEMORY_DUMP_ATTRIBUTION) ---
# Off unless true. Basis (ALERT_TO_EMAILS) is always copied. One mail per
# culprit program per day. A team with no mailbox falls back to Basis.
NOTIFY_DUMP_OWNERS=false
DUMP_TEAM_EMAIL_ABAP=
DUMP_TEAM_EMAIL_FUNCTIONAL=
# DUMP_TEAM_EMAIL_BASIS=      (defaults to ALERT_TO_EMAILS)

# --- Performance RCA (emergency diagnostic sweep) -------------------------
# Threshold-triggered from the live wall, or the "Performance monitoring"
# button on a system's Health report tab. Captures SM50/ST03N/STAD/SM12/ST04,
# OCRs them, asks the model who is causing the spike, writes a PDF, emails it.
# Needs IBO_ENABLE_AI=1 for the model step and IBO_ENABLE_EMAIL=1 to send.
# Thresholds and the task list live in config/rca.yaml.
IBO_ENABLE_RCA=0
