# InfraBeatOps -- .env.example
# Copy to .env and fill in. .env is gitignored; never commit it.
# Secrets can also live in the OS credential store: python scripts\set_secret.py NAME
#
# Values shown are the code defaults (blank = no default).

# ---- Dashboard / API ---------------------------------------------
IBO_API_TOKEN=
IBO_SLOW_REQUEST_MS=500
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EXEMPT_PATHS=
RATE_LIMIT_REQUESTS=3000
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=600

# ---- Alerting: e-mail and escalation -----------------------------
ALERT_CC_EMAILS=
ALERT_FROM_EMAIL=
ALERT_MANAGER_EMAILS=
ALERT_TO_EMAILS=
DUMP_TEAM_EMAIL_BASIS=
ESCALATION_REPEAT_THRESHOLD=2
JOB_OWNER_EXCLUDE=
NOTIFY_DUMP_OWNERS=false
NOTIFY_JOB_OWNERS=false
SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USERNAME=

# ---- Alerting: WhatsApp (Meta Cloud API, paid per conversation) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ENABLED=false
WHATSAPP_MAX_IMAGES=8
WHATSAPP_MODE=cloud_api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENTS=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_WEBHOOK_URL=

# ---- AI analysis -------------------------------------------------
AI_PROVIDER=
AI_PROVIDER_CHAIN=
AI_PSEUDONYMISE_USERS=true
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta",
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_MODEL=gemini-3.6-flash",
GEMINI_THINKING_LEVEL=low",
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MAX_OUTPUT_TOKENS=
GROK_MODEL=grok-4.3
USE_MOCK_AI=true

# ---- SAP GUI scripting host --------------------------------------
GUI_HIDDEN_MODE=false
IBO_GUI_CLOSE_AFTER_SWEEP=1
IBO_GUI_MAX_BUSY_WAIT=str(max_busy_wait
IBO_GUI_SETTLE=0.3
IBO_GUI_WAIT=0.3
IBO_LOGIN_KEY_WAIT=0.15
IBO_LOGIN_SUBMIT_WAIT=1.0
IBO_LOGIN_TAB_WAIT=0.10
IBO_MIN_DIALOG_STEPS=10
IBO_OCR_ALWAYS=
IBO_SAPLOGON_PAD_TITLE=
IBO_SAPLOGON_SETTLE=0.3
IBO_TESSERACT_CONFIG=
SAPLOGON_EXE_PATH=
SAP_CLIENT=
SAP_CONNECTION_NAME=
SAP_INSTANCE_NR=
SAP_LANGUAGE=EN
SAP_PASSWORD=
SAP_USERNAME=
TESSDATA_PREFIX=
TESSERACT_PATH=

# ---- RFC collector -----------------------------------------------
IBO_LIVE_AUTO_REFRESH=0
IBO_LIVE_DEEP_TTL_SECONDS=300
IBO_LIVE_PASS_TIMEOUT=45
IBO_LIVE_REFRESH_SECONDS=60
IBO_LIVE_TTL_SECONDS=60
IBO_LIVE_WORKERS=3
IBO_PERF_STALE_WHILE_REVALIDATE=1
IBO_PERF_TTL_SECONDS=300
IBO_RFC_AUTH_MAX_FAILURES=3
IBO_RFC_PROCESSES=2
IBO_RFC_TCP_PROBE_TIMEOUT=2
IBO_SM58_READ_LIMIT=SM58_READ_LIMIT_DEFAULT
IBO_SMON_UPTIME_DAYS=30
IBO_STAT_WINDOW_MINUTES=5

# ---- Pipeline timeouts -------------------------------------------
IBO_PIPELINE_JOIN_GRACE=90
IBO_PIPELINE_STALL=180
IBO_PIPELINE_TIMEOUT=20 * 60

# ---- Scheduling, deliveries, run history --------------------------
# How late a planned slot may still start (minutes); older = recorded missed.
IBO_SCHEDULE_GRACE_MINUTES=60
# After a restart, a slot still inside the grace window runs once (catch-up);
# older slots are recorded missed. MONITOR_ON_STARTUP is no longer used.
# MONITOR_ON_STARTUP=false
# Time budget per mail/WhatsApp delivery on the outbox worker (seconds).
IBO_DELIVERY_TIMEOUT_SECONDS=300
# python main.py waits this long for queued deliveries before it exits.
IBO_DELIVERY_DRAIN_SECONDS=900
# The report is sent only when SAP GUI screenshots were captured (0 = always).
IBO_REPORT_REQUIRE_SCREENSHOTS=1
# Reachability states that park a system's sweeps when a sweep collects nothing.
IBO_SWEEP_PARK_STATES=system_down
# Run history database (default dashboard/run_history.sqlite) and retention.
#IBO_RUN_HISTORY_DB=
IBO_RUN_HISTORY_DAYS=180
#IBO_OUTBOX_DIR=
IBO_OUTBOX_KEEP_DAYS=7

# ---- Single-system fallback (used when systems.yaml has no value) ----
SSH_HOST=
SSH_PASSWORD=
SSH_PORT=22
SSH_USERNAME=

# ---- Other ------------------------------------------------------
IBO_ENABLE_AI=0
IBO_ENABLE_EMAIL=0
IBO_ENABLE_RCA=0

# ---- Per-system values referenced from config/systems.yaml ----------
# One block per system; <SYS> is the system name upper-cased, spaces -> _.
# Written automatically by the Systems page / scripts/migrate_systems_to_env.py.
#<SYS>_SAP_CONNECTION_NAME=   # SAP Logon Pad entry, exact match
#<SYS>_SAP_USERNAME=
#<SYS>_SAP_PASSWORD=
#<SYS>_RFC_HOST=
#<SYS>_RFC_SYSNR=00
#<SYS>_RFC_CLIENT=
#<SYS>_RFC_USER=
#<SYS>_RFC_PASSWORD=
#<SYS>_SAPROUTER=            # optional, verbatim route string
#<SYS>_SSH_HOST=
#<SYS>_SSH_USERNAME=
#<SYS>_SSH_PASSWORD=
#<SYS>_SMTP_HOST=
#<SYS>_SMTP_USERNAME=
#<SYS>_SMTP_PASSWORD=
#<SYS>_SENDER_EMAIL=
#<SYS>_ALERT_RECEIVERS=      # consultants (tier 1)
#<SYS>_ALERT_RECEIVERS_CC=
#<SYS>_MANAGER_RECEIVERS=    # tier 2: added on a repeated breach

# ---- Operations features (Oct 2026) ----------------------------------
# Address people use to open THIS dashboard; needed for the Snooze /
# Acknowledge buttons in alert mails. Empty = mails without buttons.
IBO_PUBLIC_URL=
# Mail buttons only when every recipient is in these domains (comma list).
IBO_INTERNAL_DOMAINS=infrabeat.com
# Reachability states that park scheduled sweeps automatically.
IBO_AUTO_PARK=credentials
# Learned normal values: smart | annotate | off
IBO_LEARNED_MODE=smart
# Capacity forecast: mail when something runs out within N days, at this hour.
IBO_FORECAST_WARN_DAYS=30
IBO_FORECAST_HOUR=8
# Tickets: off | email | webhook | jira | servicenow   (see core/tickets.py)
IBO_TICKETS=off
IBO_TICKET_KINDS=system_down,critical
#IBO_TICKET_EMAIL=helpdesk@example.com
#IBO_TICKET_WEBHOOK_URL=
#IBO_TICKET_WEBHOOK_SECRET=
#IBO_JIRA_URL=  IBO_JIRA_USER=  IBO_JIRA_TOKEN=  IBO_JIRA_PROJECT=  IBO_JIRA_ISSUETYPE=Task
#IBO_SNOW_URL=  IBO_SNOW_USER=  IBO_SNOW_PASSWORD=  IBO_SNOW_ASSIGNMENT_GROUP=
# One-click SAP actions (also tick them per system on the Systems page).
IBO_ACTIONS_ENABLED=0
IBO_ACTIONS_TWO_PERSON=0
IBO_ACTION_LOCK_MIN_AGE_MIN=60
# Windows VM <-> Ubuntu watching: the Windows dashboard posts a heartbeat to
# every remote source with a token; Ubuntu alerts after this many minutes.
IBO_PEER_PUSH=1
IBO_PEER_SILENT_MINUTES=5
#IBO_PEER_PROBE_<WINDOWS_HOSTNAME>=10.1.0.50:3389
# File systems from CCMS RZ20 for capacity forecasts (hourly per system).
IBO_CCMS_FILESYSTEMS=1

# ---- Round 2 (Oct 2026): exception handling, checks, escalation, SSO ----
# Real-time exception handling (core/errors.py) -- on by default.
IBO_ERROR_MAIL=1
IBO_ERROR_MAIL_HOURS=6
IBO_ERROR_MAIL_DAILY_CAP=20
#IBO_ERROR_MAIL_SOURCES=web,thread,process,loop,sweep,log,job
# Extra SAP checks (collectors/extra_checks.py) and their mails.
IBO_EXTRA_CHECKS=1
IBO_EXTRA_CHECKS_MINUTES=30
IBO_CHECK_ALERTS=1
IBO_CHECK_ALERT_MINUTES=30
IBO_CHANGE_SNAPSHOT_HOURS=6
# Checks, change snapshots and the synthetic logon run in one separate worker
# process (core/rfc_proc.py) so RFC never freezes the web pages. 0 = in-process.
IBO_CHECK_PROCESSES=1
# Escalation SMS / voice through MSG91 (notifications/sms.py, config/escalation.yaml).
#IBO_MSG91_AUTHKEY=
#IBO_MSG91_FLOW_ID=
#IBO_MSG91_SENDER=IBOPS
#IBO_MSG91_SMS_VARS=VAR1=system,VAR2=state,VAR3=minutes
#IBO_MSG91_VOICE_URL=
#IBO_MSG91_VOICE_BODY={"client_number": "{mobile}", "text": "{message}"}
# WhatsApp alerts (notifications/whatsapp.py): needs WHATSAPP_ENABLED=true too.
#WHATSAPP_ALERT_TEMPLATE=ibops_alert_text
#WHATSAPP_ALERT_RECIPIENTS=9198xxxxxxxx
#IBO_WHATSAPP_ALERT_KINDS=system_down,vpn_down,credentials,critical,monitor_down,peer_silent,failover,recovered
# At most one WhatsApp per alert per this many minutes (also while mail is failing).
IBO_WHATSAPP_MIN_MINUTES=30
# Synthetic transaction (core/synthetic.py) -- off: each run is a logon.
IBO_SYNTHETIC=0
IBO_SYNTHETIC_MINUTES=10
IBO_SYNTHETIC_WARN_MS=3000
# Weekly digest (core/digest.py).
IBO_DIGEST=1
IBO_DIGEST_DAY=mon
IBO_DIGEST_HOUR=8
# One-click actions: users that are never unlocked from the dashboard.
IBO_ACTION_PROTECTED_USERS=SAP*,DDIC,TMSADM
# Microsoft Entra ID sign-in (core/sso.py, config/sso.yaml).
# TENANT_ID must be your organisation's Directory (tenant) ID -- "common" /
# "organizations" are refused (they would let other organisations in).
#IBO_ENTRA_TENANT_ID=
#IBO_ENTRA_CLIENT_ID=
#IBO_ENTRA_CLIENT_SECRET=

# ---- Alert delivery (Oct 2026; values shown are the defaults) ----------------
# Hysteresis per value (core/alert_engine.py); any of these can also be set per
# metric / per system in config/thresholds.yaml / thresholds_systems.yaml as
# raise_after, raise_minutes, clear_after, clear_pct, recovery_min_minutes.
#IBO_ALERT_RAISE_AFTER=3            # consecutive breaching readings before an alert
#IBO_ALERT_RAISE_MINUTES=0          # ... or minutes in breach (0 = off)
#IBO_ALERT_CLEAR_AFTER=3            # consecutive readings at/below the clear level
#IBO_ALERT_CLEAR_PCT=80             # clear level, % of the alerting limit
#IBO_ALERT_RECOVERY_MIN_MINUTES=30  # no "back to normal" mail for a shorter alert
#IBO_ALERT_ESCALATE_WINDOW_MIN=120  # 2nd breach inside this -> manager (ORANGE/RED)
# The client never receives internal alerts. Ours = IBO_INTERNAL_DOMAINS
# (above); the client's = report receivers outside it, plus:
#IBO_CLIENT_EMAILS=
# The delivery gate (core/alert_ledger.py)
#IBO_DISABLED_MAIL_KINDS=sweep_failure,report_held   # no "pipeline failed" / "REPORT HELD" mails
#IBO_MAIL_CAP_PER_SYSTEM=40         # mails per system per rolling 24 h
#IBO_MAIL_CAP_TOTAL=300             # mails in total per rolling 24 h (Gmail: 500)
# SMTP transport (notifications/mailer.py)
#IBO_SMTP_TIMEOUT=20
#IBO_SMTP_RETRIES=1                 # transient failures only; a 5xx is never retried
#IBO_MAIL_SUSPEND_MINUTES=60        # after a quota answer (550 5.4.5), then one probe
#IBO_SECONDARY_SMTP_ACCOUNT=        # account id in config/delivery_accounts.yaml, used for
                                    # CRITICAL / SYSTEM DOWN while the main mailbox is suspended
# SYSTEM DOWN after this many consecutive failed polls (default: the
# consecutive_failures of SAP_SYSTEM_UNREACHABLE in correlation_rules.yaml, 2)
#IBO_DOWN_CONSECUTIVE_FAILURES=
# AI budget (free Gemini tier)
#IBO_GEMINI_RPM=8                   # requests per minute from this process
#IBO_GEMINI_MINUTE_BACKOFF_S=60     # pause after a per-minute 429
#IBO_GEMINI_DAILY_RESET_UTC_HOUR=8  # per-day quota resets at midnight Pacific
#IBO_RCA_DAILY_CAP=4                # automatic RCA runs per system per day
#IBO_AI_ST22_BANDS=1,10,50,200,1000 # ST22 re-analysed only in a higher band (per SAP day)
#IBO_AI_SUMMARY_MIN_MINUTES=30      # live report: one AI summary per system per N min
