# Normalise line endings so Windows checkouts stop showing 455 "modified" files.
* text=auto
*.py text eol=lf
*.abap text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.mp4 binary
*.xlsx binary
*.pdf binary

# Left out of `git archive` -- the safe way to build a zip to share.
.env export-ignore
.env.* export-ignore
.venv export-ignore
logs export-ignore
reports export-ignore
recordings export-ignore
data export-ignore
dashboard/snapshots export-ignore
scripts/dev export-ignore
.github export-ignore
